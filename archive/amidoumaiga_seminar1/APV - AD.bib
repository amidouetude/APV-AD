	file = {PDF:files/80/Möller and Müller - 2012 - Effects of anaerobic digestion on digestate nutrient availability and crop growth A review.pdf:application/pdf},
}

@article{lindorfer_new_2008,
	title = {New data on temperature optimum and temperature changes in energy crop digesters},
	volume = {99},
	rights = {https://www.elsevier.com/tdm/userlicense/1.0/},
	issn = {09608524},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0960852408000345},
	doi = {10.1016/j.biortech.2008.01.034},
	abstract = {As a result of self-heating in anaerobic digesters when using energy crops in the feedstock, the inﬂuence of temperature on the digestion process came back into focus. The aim of this study was to investigate the impact of such temperature increases on process stability. Furthermore, diﬀerent strategies for the transition from mesophilic to thermophilic conditions and the resulting methane yields at different temperature levels were evaluated. Two main eﬀects were identiﬁed with diﬀerent bio-slurries from agricultural biogas plants: (1) a failure of methane production connected to changes in the microbial community; and (2), a slow but continuous accumulation of propionic acid, though without an immediate eﬀect on methane production. All strategies for increasing the operating temperature showed negative eﬀects on digester performance, some with serious economic consequences for the operator. It was shown that methane yields at diﬀerent temperature levels in the mesophilic and sub-thermophilic ranges are similar.},
	pages = {7011--7019},
	number = {15},
	journaltitle = {Bioresource Technology},
	shortjournal = {Bioresource Technology},
	author = {Lindorfer, H. and Waltenberger, R. and Köllner, K. and Braun, R. and Kirchmayr, R.},
	urldate = {2026-04-05},
	date = {2008-10},
	langid = {english},
	file = {PDF:files/82/Lindorfer et al. - 2008 - New data on temperature optimum and temperature changes in energy crop digesters.pdf:application/pdf},
}

